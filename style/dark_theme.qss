/* Dark Theme for SSPython

QWidget {
    background-color: #2c313a;
    color: #f0f0f0;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: #2c313a;
}

QMenuBar {
    background-color: #3c424c;
    color: #f0f0f0;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background-color: #4f5b6e;
}

QMenu {
    background-color: #3c424c;
    border: 1px solid #4f5b6e;
}

QMenu::item:selected {
    background-color: #4f5b6e;
}

QGroupBox {
    background-color: #3c424c;
    border: 1px solid #4f5b6e;
    border-radius: 5px;
    margin-top: 10px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    background-color: #3c424c;
}

QLabel {
    background-color: transparent;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #2c313a;
    border: 1px solid #4f5b6e;
    border-radius: 3px;
    padding: 5px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #7a8eb2;
}

QPushButton {
    background-color: #4f5b6e;
    border: 1px solid #4f5b6e;
    border-radius: 3px;
    padding: 5px 15px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #5a687a;
    border: 1px solid #5a687a;
}

QPushButton:pressed {
    background-color: #424e62;
}

QPushButton:disabled {
    background-color: #3c424c;
    color: #888;
}

QListWidget {
    background-color: #3c424c;
    border: 1px solid #4f5b6e;
    border-radius: 3px;
}

QListWidget::item {
    padding: 8px;
}

QListWidget::item:selected {
    background-color: #4f5b6e;
    color: #f0f0f0;
}

QStackedWidget {
    background-color: #2c313a;
}

QToolBox::tab {
    background-color: #3c424c;
    border: 1px solid #4f5b6e;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 8px;
    font-weight: bold;
}

QToolBox::tab:selected {
    background-color: #4f5b6e;
}

QFrame#sidebar {
    background-color: #3c424c;
    border-right: 1px solid #4f5b6e;
}

QListWidget#navList {
    background-color: #3c424c;
    border: none;
}

QListWidget#navList::item {
    border-bottom: 1px solid #4f5b6e;
    padding: 15px;
    color: #f0f0f0;
}

QListWidget#navList::item:selected {
    background-color: #4f5b6e;
    border-left: 3px solid #7a8eb2;
    color: #fff;
} */
